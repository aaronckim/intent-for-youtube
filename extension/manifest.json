{
  "manifest_version": 3,
  "name": "Intent: Focus Mode for YouTube",
  "short_name": "Intent",
  "version": "0.1.0",
  "description": "Use YouTube for what you came for. Hide Shorts and recommendations, and fade out off-topic videos. Runs entirely on your device.",
  "homepage_url": "https://github.com/aaronckim/intent-for-youtube",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Intent",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/settings.js",
        "src/intent.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_start"
    }
  ]
}
